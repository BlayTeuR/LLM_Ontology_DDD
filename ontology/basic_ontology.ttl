@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ddd: <http://example.org/ddd#> . # Trouver une bonne ressource

# ============================================================
# Ontology
# ============================================================

# Core label
ddd: a owl:Ontology ;
    rdfs:label "DDD Core Ontology" .

# ============================================================
# Classes (All DDD Artefact)
# ============================================================

# Core classes
ddd:DDDConcept a owl:Class .

ddd:Strategic a owl:Class ;
    rdfs:label "Strategic" ;
    rdfs:subClassOf ddd:DDDConcept .

ddd:Tactical a owl:Class ;
    rdfs:label "Tactical" ;
    rdfs:subClassOf ddd:DDDConcept .
    
# Strategic

ddd:ContextMap a owl:Class ;
    rdfs:label "Context Map" ;
    rdfs:subClassOf ddd:Strategic .

ddd:BoundedContext a owl:Class ;
    rdfs:label "BoundedContext" ;
    rdfs:subClassOf ddd:Strategic .

ddd:UbiquitousLanguage a owl:Class ;
    rdfs:label "Ubiquitous Languge" ;
    rdfs:subClassOf ddd:Strategic .

# Tactical

ddd:Aggregate a owl:Class ;
    rdfs:label "Aggregate" ;
    rdfs:subClassOf ddd:Tactical .

ddd:DomainService a owl:Class ;
    rdfs:label "Domain Service" ;
    rdfs:subClassOf ddd:Tactical .

ddd:DomainEvent a owl:Class ;
    rdfs:label "Domain Event" ;
    rdfs:subClassOf ddd:Tactical .  

ddd:Repository a owl:Class ;
    rdfs:label "Repository" ;
    rdfs:subClassOf ddd:Tactical .

ddd:DomainObject a owl:Class ;
    rdfs:label "Domain Object" ;
    rdfs:subClassOf ddd:Tactical .

ddd:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:subClassOf ddd:DomainObject .

ddd:ValueObject a owl:Class ;
    rdfs:label "Value Object" ;
    rdfs:subClassOf ddd:DomainObject .

ddd:AggregateRoot a owl:Class ;
    rdfs:label "Aggregate Root" ;
    rdfs:subClassOf ddd:Entity . # Le point d'accès est toujours une Entity

# ============================================================
# Definitions
# ============================================================

# Generic contain property
ddd:contains a owl:ObjectProperty .

ddd:containsAggregate a owl:ObjectProperty ;
    rdfs:label "contains Aggregate" ;
    rdfs:comment "Associates a bounded context with an aggregate it contains." ;
    rdfs:subPropertyOf ddd:contains ;
    rdfs:domain ddd:BoundedContext ;
    rdfs:range ddd:Aggregate .

ddd:containsEntity a owl:ObjectProperty ;
    rdfs:label "contains Entity" ;
    rdfs:comment "Associates an Aggregate with an Entity it contains." ;
    rdfs:subPropertyOf ddd:contains ;
    rdfs:domain ddd:Aggregate ;
    rdfs:range ddd:Entity .

ddd:containsValueObject a owl:ObjectProperty ;
    rdfs:label "contains Value object" ;
    rdfs:comment "Associates an Aggregate with a Value Object it contains." ;
    rdfs:subPropertyOf ddd:contains ;
    rdfs:domain ddd:Aggregate ;
    rdfs:range ddd:ValueObject .

# has Property
ddd:hasUbiquitousLanguage a owl:ObjectProperty ;
    rdfs:label "has ubiquitous language" ;
    rdfs:subPropertyOf ddd:contains ;
    rdfs:domain ddd:BoundedContext ;
    rdfs:range ddd:UbiquitousLanguage .

ddd:hasRoot a owl:ObjectProperty, owl:FunctionalProperty ; # Une seule et même Entity
    rdfs:label "has root" ;
    rdfs:subPropertyOf ddd:contains ;
    rdfs:domain ddd:Aggregate ;
    rdfs:range ddd:AggregateRoot .# AggregateRoot is an Entity

# manages (V1 need upgrade)
ddd:manageAggregate a owl:ObjectProperty ;
    rdfs:label "manage aggregate" ;
    rdfs:domain ddd:Repository ;
    rdfs:range ddd:AggregateRoot .

# relates (V1 need upgrade)
ddd:relatesToBoundedContext a owl:ObjectProperty ;
    rdfs:label "relates to Bounded Context" ;
    rdfs:domain ddd:ContextMap ;
    rdfs:range ddd:BoundedContext .

# Generic belongsTo property (inverse of contain)
ddd:belongsTo a owl:ObjectProperty .

ddd:belongsToAggregate a owl:ObjectProperty ;
    rdfs:label "belongs to bounded context" ;
    rdfs:comment "Associates a Domain object (Value object or Entity) with the Aggregate to which it belongs." ;
    rdfs:subPropertyOf ddd:belongsTo ;
    rdfs:domain ddd:DomainObject ; # ValueObject ou Entity
    rdfs:range ddd:Aggregate .

ddd:belongsToBoundedContext a owl:ObjectProperty ;
    rdfs:label "belongs to bounded context" ;
    rdfs:comment "Associates an aggregate with the bounded context to which it belongs." ;
    rdfs:subPropertyOf ddd:belongsTo ;
    rdfs:domain ddd:Aggregate ;
    rdfs:range ddd:BoundedContext .

# Inverse Of
ddd:containsAggregate owl:inverseOf ddd:belongsToBoundedContext .
ddd:containsEntity owl:inverseOf ddd:belongsToAggregate .
ddd:containsValueObject owl:inverseOf ddd:belongsToAggregate .

# ============================================================
# Restriction and cardinality
# ============================================================

# Un Aggregate ne peut avoir qu'une Entity root
ddd:Aggregate rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ddd:hasRoot ;
    owl:onClass ddd:AggregateRoot ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
] .

# Un BoundedContext ne possède qu'un seul et même UbiquitousLangage
ddd:BoundedContext rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ddd:hasUbiquitousLangage ;
    owl:onClass ddd:UbiquitousLanguage ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
] .

# ============================================================
# Logical axioms
# ============================================================

ddd:Strategic owl:disjointWith ddd:Tactical .

[] a owl:AllDisjointClasses ;
    owl:members(
        ddd:DomainObject
        ddd:Entity
        ddd:ValueObject
        ddd:Aggregate
        ddd:DomainService
        ddd:Repository
        ddd:DomainEvent
    ) .