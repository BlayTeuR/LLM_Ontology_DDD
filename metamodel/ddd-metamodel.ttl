@prefix ddd:  <https://example.org/ddd-metamodel#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =====================================================================
#  DDD Metamodel (strategic + tactical) -- current version
#  Conceptual source: Kapferer's metamodel (Strategic / Tactic DDD).
#  Scope: Context Map, Bounded Context, Domain/Subdomain, Context Mapping
#  relationships and roles, Aggregate / Entity / RootEntity /
#  ValueObject / DomainEvent, Attribute, Conflict.
#
#  NOTE: the https://example.org/... namespace is a PLACEHOLDER.
#  NOTE: the AllDifferent axiom is NOT in this file: it is added by the
#        pipeline (reason.py) over the individuals of each artifact.
# =====================================================================

<https://example.org/ddd-metamodel> a owl:Ontology ;
    owl:versionIRI <https://example.org/ddd-metamodel/0.2.0> ;
    owl:versionInfo "0.2.0 (0.1.0 + ownedBy, bcType, implementationTechnology, contextMapType, contextMapState)" ;
    owl:priorVersion <https://example.org/ddd-metamodel/0.1.0> ;
    rdfs:label "DDD Metamodel (strategic + tactical)" ;
    rdfs:comment "OWL 2 DL metamodel of strategic and tactical DDD, derived from Kapferer's metamodel, targeted by artifacts generated from CML or by an LLM." .

# ---------------------------------------------------------------------
#  Annotation: mapping to CML keywords (TBox-driven mapper). Has no
#  effect on reasoning. Values to be checked against the CML grammar.
# ---------------------------------------------------------------------

ddd:cmlConstruct a owl:AnnotationProperty ;
    rdfs:label "CML construct" ;
    rdfs:comment "CML keyword corresponding to this element." .

# ---------------------------------------------------------------------
#  Classes: context, map, domain
# ---------------------------------------------------------------------

ddd:ContextMap a owl:Class ;
    rdfs:label "Context Map" ;
    ddd:cmlConstruct "ContextMap" .

ddd:BoundedContext a owl:Class ;
    rdfs:label "Bounded Context" ;
    ddd:cmlConstruct "BoundedContext" .

ddd:Domain a owl:Class ;
    rdfs:label "Domain" ;
    rdfs:comment "Extension beyond the Kapferer diagrams: CML declares subdomains inside a Domain." ;
    ddd:cmlConstruct "Domain" .

ddd:Subdomain a owl:Class ;
    rdfs:label "Subdomain" ;
    ddd:cmlConstruct "Subdomain" .

ddd:CoreDomain a owl:Class ;
    rdfs:subClassOf ddd:Subdomain ;
    rdfs:label "Core Domain" ;
    ddd:cmlConstruct "CORE_DOMAIN" .

ddd:SupportingSubdomain a owl:Class ;
    rdfs:subClassOf ddd:Subdomain ;
    rdfs:label "Supporting Subdomain" ;
    ddd:cmlConstruct "SUPPORTING_DOMAIN" .

ddd:GenericSubdomain a owl:Class ;
    rdfs:subClassOf ddd:Subdomain ;
    rdfs:label "Generic Subdomain" ;
    ddd:cmlConstruct "GENERIC_SUBDOMAIN" .

# ---------------------------------------------------------------------
#  Classes: relationships between Bounded Contexts
# ---------------------------------------------------------------------

ddd:BoundedContextRelationship a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:unionOf ( ddd:SymmetricRelationship ddd:UpstreamDownstreamRelationship ) ] ;
    rdfs:label "Bounded Context Relationship" ;
    rdfs:comment "Abstract class: do not instantiate directly, use a subclass." .

ddd:SymmetricRelationship a owl:Class ;
    rdfs:subClassOf ddd:BoundedContextRelationship ;
    rdfs:label "Symmetric Relationship" .

ddd:Partnership a owl:Class ;
    rdfs:subClassOf ddd:SymmetricRelationship ;
    rdfs:label "Partnership" ;
    ddd:cmlConstruct "Partnership" .

ddd:SharedKernel a owl:Class ;
    rdfs:subClassOf ddd:SymmetricRelationship ;
    rdfs:label "Shared Kernel" ;
    ddd:cmlConstruct "Shared-Kernel" .

ddd:UpstreamDownstreamRelationship a owl:Class ;
    rdfs:subClassOf ddd:BoundedContextRelationship ;
    rdfs:label "Upstream-Downstream Relationship" ;
    rdfs:comment "Generic upstream-downstream relationship (to be instantiated directly when it is not a Customer-Supplier)." ;
    ddd:cmlConstruct "Upstream-Downstream" .

ddd:CustomerSupplierRelationship a owl:Class ;
    rdfs:subClassOf ddd:UpstreamDownstreamRelationship ;
    rdfs:label "Customer/Supplier Relationship" ;
    ddd:cmlConstruct "Customer-Supplier" .

# ---------------------------------------------------------------------
#  Classes: roles in an upstream-downstream relationship
# ---------------------------------------------------------------------

ddd:UpstreamRole a owl:Class ;
    rdfs:label "Upstream Role" ;
    rdfs:comment "Abstract class: role carried by the upstream context." .

ddd:DownstreamRole a owl:Class ;
    rdfs:label "Downstream Role" ;
    rdfs:comment "Abstract class: role carried by the downstream context." .

ddd:PublishedLanguage a owl:Class ;
    rdfs:subClassOf ddd:UpstreamRole ;
    rdfs:label "Published Language (PL)" ;
    ddd:cmlConstruct "PL" .

ddd:OpenHostService a owl:Class ;
    rdfs:subClassOf ddd:UpstreamRole ;
    rdfs:label "Open Host Service (OHS)" ;
    ddd:cmlConstruct "OHS" .

ddd:AnticorruptionLayer a owl:Class ;
    rdfs:subClassOf ddd:DownstreamRole ;
    rdfs:label "Anticorruption Layer (ACL)" ;
    ddd:cmlConstruct "ACL" .

ddd:Conformist a owl:Class ;
    rdfs:subClassOf ddd:DownstreamRole ;
    rdfs:label "Conformist (CF)" ;
    ddd:cmlConstruct "CF" .

# ---------------------------------------------------------------------
#  Classes: minimal tactical elements
# ---------------------------------------------------------------------

ddd:Aggregate a owl:Class ;
    rdfs:label "Aggregate" ;
    ddd:cmlConstruct "Aggregate" ;
    # Rule: an Aggregate has a single root (RootEntity).
    # "At most 1" is checkable by HermiT (provided the roots are declared
    # distinct: see reason.py). "At least 1" is not checkable under the
    # open-world assumption: handled in SHACL (shapes.ttl).
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty ddd:containsEntity ;
        owl:onClass ddd:RootEntity ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

ddd:Entity a owl:Class ;
    rdfs:label "Entity" ;
    ddd:cmlConstruct "Entity" .

ddd:RootEntity a owl:Class ;
    rdfs:subClassOf ddd:Entity ;
    rdfs:label "Root Entity (Aggregate Root)" ;
    ddd:cmlConstruct "aggregateRoot" .

ddd:ValueObject a owl:Class ;
    rdfs:label "Value Object" ;
    ddd:cmlConstruct "ValueObject" .

ddd:DomainEvent a owl:Class ;
    rdfs:label "Domain Event" ;
    ddd:cmlConstruct "DomainEvent" .

ddd:Attribute a owl:Class ;
    rdfs:label "Attribute" ;
    rdfs:comment "Member of an Entity, a ValueObject or a DomainEvent: either a simple attribute (String name) or a reference to another term (- Customer client, which then carries ddd:refersTo). A node (not plain text) so that the members of two terms can be compared across BCs. Its type is a string (ddd:attributeType)." ;
    ddd:cmlConstruct "Attribute" .

# ---------------------------------------------------------------------
#  Classes: V0 output (detected conflicts, not CML elements)
# ---------------------------------------------------------------------

ddd:Conflict a owl:Class ;
    rdfs:label "Conflict" ;
    rdfs:comment "Conflict detected between elements of two BCs (or within a relationship). Produced by a rule (ddd:detectedBy = rule:<id>) or proposed by the LLM (ddd:detectedBy = llm), then validated by a human (ddd:status)." .

# ---------------------------------------------------------------------
#  Disjointness
#  The only real HermiT check in V0 together with domain/range: detects
#  typing errors on an element.
# ---------------------------------------------------------------------

[] a owl:AllDisjointClasses ; owl:members (
    ddd:ContextMap ddd:BoundedContext ddd:Domain ddd:Subdomain
    ddd:BoundedContextRelationship ddd:UpstreamRole ddd:DownstreamRole
    ddd:Aggregate ddd:Entity ddd:ValueObject ddd:DomainEvent
    ddd:Attribute ddd:Conflict ) .

[] a owl:AllDisjointClasses ; owl:members ( ddd:CoreDomain ddd:SupportingSubdomain ddd:GenericSubdomain ) .
[] a owl:AllDisjointClasses ; owl:members ( ddd:SymmetricRelationship ddd:UpstreamDownstreamRelationship ) .
[] a owl:AllDisjointClasses ; owl:members ( ddd:PublishedLanguage ddd:OpenHostService ) .
[] a owl:AllDisjointClasses ; owl:members ( ddd:AnticorruptionLayer ddd:Conformist ) .

# ---------------------------------------------------------------------
#  Object properties
# ---------------------------------------------------------------------

# --- Context Map ---

ddd:showsRelevantContext a owl:ObjectProperty ;
    rdfs:label "shows relevant context" ;
    rdfs:domain ddd:ContextMap ; rdfs:range ddd:BoundedContext .

ddd:showsRelationship a owl:ObjectProperty ;
    rdfs:label "shows relationship" ;
    rdfs:domain ddd:ContextMap ; rdfs:range ddd:BoundedContextRelationship .

# --- Bounded Context <-> Subdomain ---

ddd:implementsPartOf a owl:ObjectProperty ;
    rdfs:label "implements part of" ;
    rdfs:domain ddd:BoundedContext ; rdfs:range ddd:Subdomain ;
    owl:inverseOf ddd:implementedBy .

ddd:implementedBy a owl:ObjectProperty ;
    rdfs:domain ddd:Subdomain ; rdfs:range ddd:BoundedContext .

# --- Bounded Context <-> Aggregate ---

ddd:hasAggregate a owl:ObjectProperty ;
    rdfs:label "has aggregate" ;
    rdfs:comment "The Kapferer diagram shows 'implements multiple' between Bounded Context and Aggregate." ;
    rdfs:domain ddd:BoundedContext ; rdfs:range ddd:Aggregate ;
    owl:inverseOf ddd:aggregateOf .

ddd:aggregateOf a owl:ObjectProperty ;
    rdfs:domain ddd:Aggregate ; rdfs:range ddd:BoundedContext .

ddd:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by" ;
    rdfs:domain ddd:Aggregate ; rdfs:range ddd:BoundedContext .

# --- Domain <-> Subdomain ---

ddd:hasSubdomain a owl:ObjectProperty ;
    rdfs:label "has subdomain" ;
    rdfs:domain ddd:Domain ; rdfs:range ddd:Subdomain ;
    owl:inverseOf ddd:subdomainOf .

ddd:subdomainOf a owl:ObjectProperty ;
    rdfs:domain ddd:Subdomain ; rdfs:range ddd:Domain .

# --- Contents of aggregates / subdomains ---

ddd:containsEntity a owl:ObjectProperty ;
    rdfs:label "contains entity" ;
    rdfs:comment "An Entity is contained by an Aggregate or a Subdomain (both are shown in the Kapferer diagrams). The root is an Entity of type RootEntity." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ddd:Aggregate ddd:Subdomain ) ] ;
    rdfs:range ddd:Entity .

ddd:containsValueObject a owl:ObjectProperty ;
    rdfs:domain ddd:Aggregate ; rdfs:range ddd:ValueObject .

ddd:containsDomainEvent a owl:ObjectProperty ;
    rdfs:comment "Simplification: Kapferer's tactical diagram does not show this composition; CML declares DomainEvents inside an Aggregate (to be checked)." ;
    rdfs:domain ddd:Aggregate ; rdfs:range ddd:DomainEvent .

ddd:hasAttribute a owl:ObjectProperty ;
    rdfs:label "has attribute" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ddd:Entity ddd:ValueObject ddd:DomainEvent ) ] ;
    rdfs:range ddd:Attribute .

ddd:refersTo a owl:ObjectProperty ;
    rdfs:label "refers to" ;
    rdfs:comment "A CML reference (- Type name) is an Attribute whose type is another term: refersTo points to that term. It is the dependency link between terms, including across different BCs (a BC that references a term defined in another one)." ;
    rdfs:domain ddd:Attribute ;
    rdfs:range [ a owl:Class ; owl:unionOf ( ddd:Entity ddd:ValueObject ddd:DomainEvent ) ] .

# --- Conflicts ---

ddd:involves a owl:ObjectProperty ;
    rdfs:label "involves" ;
    rdfs:comment "Elements in conflict (BC, Entity, ValueObject, Attribute, relationship...). No range: the type depends on the conflict." ;
    rdfs:domain ddd:Conflict .

# --- Relationships ---

ddd:hasParticipant a owl:ObjectProperty ;
    rdfs:label "has participant" ;
    rdfs:domain ddd:SymmetricRelationship ; rdfs:range ddd:BoundedContext .

ddd:upstream a owl:ObjectProperty ;
    rdfs:domain ddd:UpstreamDownstreamRelationship ; rdfs:range ddd:BoundedContext .

ddd:downstream a owl:ObjectProperty ;
    rdfs:domain ddd:UpstreamDownstreamRelationship ; rdfs:range ddd:BoundedContext .

ddd:hasUpstreamRole a owl:ObjectProperty ;
    rdfs:label "has upstream role" ;
    rdfs:domain ddd:UpstreamDownstreamRelationship ; rdfs:range ddd:UpstreamRole .

ddd:hasDownstreamRole a owl:ObjectProperty ;
    rdfs:label "has downstream role" ;
    rdfs:domain ddd:UpstreamDownstreamRelationship ; rdfs:range ddd:DownstreamRole .

ddd:exposesAggregate a owl:ObjectProperty ;
    rdfs:label "exposes aggregate" ;
    rdfs:comment "CML exposedAggregates: aggregates that the upstream context exposes to the downstream one, i.e. the terms that cross the boundary." ;
    rdfs:domain ddd:UpstreamDownstreamRelationship ; rdfs:range ddd:Aggregate .

# ---------------------------------------------------------------------
#  Datatype properties (no domain: no type inference)
# ---------------------------------------------------------------------

ddd:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "Identifier as written in the CML (or Ubiquitous Language term). Two elements from different contexts may share the same name with distinct IRIs." ;
    rdfs:range xsd:string .

ddd:bcType a owl:DatatypeProperty ;
    rdfs:label "bounded context type" ;
    rdfs:comment "BC type in CML: FEATURE | APPLICATION | SYSTEM | TEAM (closed list checked by SHACL). TEAM = a team, not a model context." ;
    rdfs:range xsd:string .

ddd:contextMapType a owl:DatatypeProperty ;
    rdfs:label "context map type" ;
    rdfs:comment "Context Map type in CML: SYSTEM_LANDSCAPE | ORGANIZATIONAL (closed list checked by SHACL). Absent if not written in the CML." ;
    rdfs:range xsd:string .

ddd:contextMapState a owl:DatatypeProperty ;
    rdfs:label "context map state" ;
    rdfs:comment "Context Map state in CML: AS_IS | TO_BE (closed list checked by SHACL). Absent if not written in the CML." ;
    rdfs:range xsd:string .

# --- CML attributes and texts (no domain; constrained by SHACL) ---

ddd:attributeType a owl:DatatypeProperty ;
    rdfs:comment "Attribute type as written in the CML (string: String, Date, name of another object...)." ;
    rdfs:range xsd:string .

ddd:domainVisionStatement a owl:DatatypeProperty ;
    rdfs:comment "Free text of the BC (CML domainVisionStatement). Textual evidence for LLM alignment." ;
    rdfs:range xsd:string .

ddd:implementationTechnology a owl:DatatypeProperty ;
    rdfs:comment "Free text from the CML (implementationTechnology), on a BC or on a relationship between BCs." ;
    rdfs:range xsd:string .

ddd:responsibility a owl:DatatypeProperty ;
    rdfs:comment "A responsibility (CML responsibilities), on a BC or an Aggregate. Multi-valued: one value per responsibility." ;
    rdfs:range xsd:string .

# --- Conflicts: evidence and status ---

ddd:conflictType a owl:DatatypeProperty ;
    rdfs:comment "homonym | synonym | relation (closed list checked by SHACL)." ;
    rdfs:range xsd:string .

ddd:evidence a owl:DatatypeProperty ;
    rdfs:comment "Human-readable explanation of the conflict: elements compared and observed difference." ;
    rdfs:range xsd:string .

ddd:status a owl:DatatypeProperty ;
    rdfs:comment "proposed | validated | rejected (closed list checked by SHACL). A conflict proposed by the LLM stays 'proposed' until human validation." ;
    rdfs:range xsd:string .

ddd:detectedBy a owl:DatatypeProperty ;
    rdfs:comment "rule:<id> for a deterministic rule, llm for an LLM proposal." ;
    rdfs:range xsd:string .

# --- Provenance (useful to tell the CML route from the LLM route and to trace errors) ---

ddd:sourceFile a owl:DatatypeProperty ;
    rdfs:comment "Path or name of the source file (e.g. .cml file)." ;
    rdfs:range xsd:string .

ddd:sourceLine a owl:DatatypeProperty ;
    rdfs:comment "Line of the construct in the source file, if known." ;
    rdfs:range xsd:integer .

ddd:generatedBy a owl:DatatypeProperty ;
    rdfs:comment "Producer of the artifact, for example 'cml-converter' or 'llm'." ;
    rdfs:range xsd:string .
