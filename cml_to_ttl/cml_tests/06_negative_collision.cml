// Goal (NEGATIVE): two UNNAMED relationships, same upstream and same downstream -> same IRI "rel/Orders--Billing".
// The converter must refuse and tell to give the relationships a name.
// EXPECT: ERROR same IRI

ContextMap CollisionMap {
	type = SYSTEM_LANDSCAPE
	state = TO_BE
	contains Orders
	contains Billing

	Orders [U,OHS]->[D,ACL] Billing
	Orders [U,PL]->[D,CF] Billing
}

BoundedContext Orders {
	Aggregate OrderBook {
		Entity Order {
			aggregateRoot
			int orderNr
		}
	}
}

BoundedContext Billing {
	Aggregate Invoices {
		Entity Invoice {
			aggregateRoot
			BigDecimal amount
		}
	}
}
