<https://example.org/kg/insurance/rel/Library--Loans> a ddd:UpstreamDownstreamRelationship ;
    ddd:downstream <https://example.org/kg/insurance/bc/Loans> ;
    ddd:exposesAggregate <https://example.org/kg/insurance/bc/Library/Catalog> ;
    ddd:generatedBy "cml-converter" ;
    ddd:hasDownstreamRole <https://example.org/kg/insurance/rel/Library--Loans/CF> ;
    ddd:hasUpstreamRole <https://example.org/kg/insurance/rel/Library--Loans/OHS>,
