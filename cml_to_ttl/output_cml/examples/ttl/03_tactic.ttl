@prefix ddd: <https://example.org/ddd-metamodel#> .

<https://example.org/kg/insurance/map/TacticMap> a ddd:ContextMap ;
    ddd:contextMapState "TO_BE" ;
    ddd:contextMapType "SYSTEM_LANDSCAPE" ;
