<https://example.org/kg/insurance/bc/Library> a ddd:BoundedContext ;
    ddd:domainVisionStatement "Manages the books, their authors and publishers." ;
    ddd:generatedBy "cml-converter" ;
    ddd:hasAggregate <https://example.org/kg/insurance/bc/Library/Catalog>,
        <https://example.org/kg/insurance/bc/Library/Publishing> ;
    ddd:name "Library" ;
    ddd:responsibility "Catalog",
        "Publishing" ;
    ddd:sourceFile "..\\cml_tests\\03_tactic.cml" .

<https://example.org/kg/insurance/bc/Library/Catalog> a ddd:Aggregate ;
